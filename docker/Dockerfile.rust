FROM rust:1.77-alpine AS builder

RUN apk add --no-cache musl-dev protoc protobuf-dev
WORKDIR /app
COPY rust/Cargo.toml rust/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release 2>/dev/null || true

COPY rust/src src/
COPY pkg/proto/scanner.proto ../pkg/proto/scanner.proto
RUN cargo build --release

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /app/target/release/fortress-ws-scanner /usr/local/bin/fortress-ws-scanner

EXPOSE 50051
ENV SCANNER_GRPC_ADDR=0.0.0.0:50051
ENTRYPOINT ["fortress-ws-scanner"]
