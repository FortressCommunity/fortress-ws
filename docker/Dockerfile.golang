FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /fortress-gw ./cmd/fortress-gw

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /fortress-gw /usr/local/bin/fortress-gw
COPY config/default.yaml /etc/fortress-ws/config/default.yaml

EXPOSE 8443
ENTRYPOINT ["fortress-gw"]
